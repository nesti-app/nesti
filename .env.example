APP_ENV=development
APP_URL=http://localhost:8000
SECRET_KEY=

DATABASE_URL=

SUPABASE_URL=

# Modern keys (preferred)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy keys (optional fallbacks; used only if the modern ones are unset)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

SUPABASE_STORAGE_BUCKET=inventory-images

# --- S3-compatible storage (optional) ---
# When S3_ENDPOINT_URL is set, image I/O goes through Supabase Storage's S3 API
# via aiobotocore (fully async). Get credentials from Supabase Dashboard:
# Storage -> Settings -> S3 API Access.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=inventory-images
S3_REGION=us-east-1

MAX_UPLOAD_SIZE=10485760
IMAGE_MAX_DIMENSION=2400
THUMBNAIL_MAX_DIMENSION=256
LABEL_DPI=203
