APP_ENV=development
APP_URL=http://localhost:8000
SECRET_KEY=

# Optional path to the settings file (env-file). Defaults to ".env".
# Priority: real env vars > settings file > code defaults.
SETTINGS_FILE=

DATABASE_URL=

# Bootstrap admin (created on startup when local auth is enabled).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Anti-bruteforce on login.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
IP_THROTTLE_PER_MINUTE=20

SUPABASE_URL=

# Modern keys (preferred)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy keys (optional fallbacks; used only if the modern ones are unset)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

SUPABASE_STORAGE_BUCKET=inventory-images

# --- S3-compatible storage (optional) ---
# Canonical AWS env-var names; the legacy S3_* spellings below are also accepted.
# When an endpoint URL is set, image I/O goes through Supabase Storage's S3 API
# (or any S3 provider) via aiobotocore (fully async).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=

# Legacy aliases (same values as the AWS_* ones)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=inventory-images
S3_REGION=us-east-1

MAX_UPLOAD_SIZE=10485760
IMAGE_MAX_DIMENSION=2400
THUMBNAIL_MAX_DIMENSION=256
LABEL_DPI=203
