APP_ENV=development
APP_URL=http://localhost:8000
SECRET_KEY=

# Optional path to the settings file (env-file). Defaults to ".env".
# Priority: real env vars > settings file > code defaults.
SETTINGS_FILE=

# Database. Sqlite by default (no server needed). For PostgreSQL use:
#   postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/nesti.db

# Bootstrap admin (created on startup if no user with this email exists).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Anti-bruteforce on login.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
IP_THROTTLE_PER_MINUTE=20

# --- S3-compatible storage (any provider: AWS, Supabase Storage, rustfs, MinIO, ...) ---
# Canonical AWS env-var names. Legacy S3_* spellings (S3_ENDPOINT_URL,
# S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_REGION) are also accepted as aliases.
# Storage is enabled when AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are set.
# AWS_ENDPOINT_URL is optional (empty means classic AWS; set it for Supabase
# Storage S3 API, rustfs, MinIO, ...).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=
S3_BUCKET_NAME=inventory-images
S3_FORCE_PATH_STYLE=true

MAX_UPLOAD_SIZE=10485760
IMAGE_MAX_DIMENSION=2400
THUMBNAIL_MAX_DIMENSION=256
LABEL_DPI=203
